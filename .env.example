# Conexion de la base de datos MongoDB
MONGO_USER=your_user
MONGO_PASS=your_password
MONGO_DB=Api

# Clave secreta fuerte (minimo de 256 bits / 32 caracteres) para la firma y verificacion de tokens JWT
CLAVE_CIFRADO=a_long_random_secret_at_least_32_chars

# Host donde corre el servidor de produccion (empleado por los scripts frontend)
EC2_HOST=localhost

# Render deploy webhook (despliegue automatico en push a main)
RENDER_DEPLOY_URL=https://api.render.com/deploy/srv-XXXX?key=YOUR_RENDER_DEPLOY_KEY

# SteamGridDB API key
STEAM_GRID_API_KEY=your_steam_grid_api_key

# Steam Web API key
STEAM_API_KEY=your_steam_api_key
